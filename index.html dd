<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GS 4C · Carrosserie Automobile</title>
  <style>
    /* --- RESET & BASE --- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      scroll-behavior: smooth;
    }
    body {
      background: #0b0a08;
      color: #f0ece4;
      overflow-x: hidden;
    }

    /* --- LOADER --- */
    #loader {
      position: fixed;
      inset: 0;
      background: #0b0a08;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      transition: opacity 0.6s ease;
    }
    #loader.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .loader-ring {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      border: 5px solid rgba(212, 175, 55, 0.15);
      border-top-color: #d4af37;
      animation: spin 1s cubic-bezier(0.6, 0, 0.4, 1) infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* --- BACKGROUND IMAGE --- */
    .bg-image {
      position: fixed;
      inset: 0;
      z-index: -5;
      background: url('https://images.unsplash.com/photo-1603584173870-7c23e6c6b1c1?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D') center/cover no-repeat;
      filter: brightness(0.25) saturate(1.2);
      transform: scale(1.02);
    }
    .overlay-gradient {
      position: fixed;
      inset: 0;
      z-index: -4;
      background: radial-gradient(circle at 30% 40%, rgba(0,0,0,0.2) 0%, #0b0a08 85%);
    }

    /* --- LENS FLARE --- */
    .lens-flare {
      position: fixed;
      top: 15%;
      left: 60%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.25) 0%, transparent 70%);
      filter: blur(70px);
      z-index: -3;
      pointer-events: none;
      transition: 0.2s ease-out;
    }

    /* --- PARTICULES --- */
    #particles {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -2;
    }

    /* --- HEADER --- */
    header {
      text-align: center;
      padding: 50px 20px 20px;
      position: relative;
    }
    .logo {
      width: 110px;
      margin-bottom: 6px;
      filter: drop-shadow(0 0 12px rgba(212, 175, 55, 0.5));
    }
    h1 {
      font-size: 42px;
      font-weight: 600;
      letter-spacing: 4px;
      background: linear-gradient(135deg, #d4af37, #f9e28c, #d4af37);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: goldShine 5s ease-in-out infinite;
    }
    @keyframes goldShine {
      0% { background-position: 0% center; }
      50% { background-position: 100% center; }
      100% { background-position: 0% center; }
    }
    .subhead {
      font-size: 18px;
      color: #d4af37;
      letter-spacing: 2px;
      margin-top: 6px;
      opacity: 0.9;
    }
    .slogan-main {
      font-size: 20px;
      color: #e8d5a3;
      text-align: center;
      margin: 12px auto 28px;
      max-width: 700px;
      padding: 0 16px;
      font-weight: 300;
      text-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
    }

    /* --- SECTIONS --- */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .gallery-group {
      margin: 60px auto;
      padding: 0 8px;
    }
    .gallery-group h2 {
      color: #d4af37;
      font-size: 28px;
      font-weight: 400;
      letter-spacing: 1px;
      margin-bottom: 12px;
      border-left: 4px solid #d4af37;
      padding-left: 18px;
    }
    .gallery-group .desc {
      color: #cbc3b0;
      line-height: 1.7;
      margin: 8px 0 20px;
      font-size: 1.05rem;
      max-width: 900px;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 22px;
      margin: 12px 0 18px;
    }
    .gallery img {
      width: 100%;
      height: 190px;
      object-fit: cover;
      border-radius: 18px;
      cursor: pointer;
      transition: 0.4s cubic-bezier(0.2, 0.9, 0.4, 1);
      opacity: 0;
      transform: translateY(30px);
      box-shadow: 0 4px 24px rgba(0,0,0,0.6);
      border: 1px solid rgba(212, 175, 55, 0.1);
    }
    .gallery img.show {
      opacity: 1;
      transform: translateY(0);
    }
    .gallery img:hover {
      transform: scale(1.04);
      box-shadow: 0 8px 40px rgba(212, 175, 55, 0.3);
      border-color: #d4af37;
    }
    .gallery img.extra {
      display: none;
    }
    .gallery img.extra.show {
      display: block;
    }

    .show-more {
      display: inline-block;
      margin: 8px 0 12px;
      padding: 10px 32px;
      background: linear-gradient(145deg, #d4af37, #b38f2c);
      border: none;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.95rem;
      color: #0b0a08;
      cursor: pointer;
      transition: 0.3s;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 14px rgba(212, 175, 55, 0.2);
    }
    .show-more:hover {
      transform: scale(1.03);
      box-shadow: 0 6px 28px rgba(212, 175, 55, 0.5);
      background: #e2c05a;
    }

    /* --- BOUTONS PRINCIPAUX --- */
    .buttons {
      text-align: center;
      margin: 20px 0 50px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px 24px;
    }
    .btn {
      display: inline-block;
      padding: 16px 44px;
      border-radius: 60px;
      background: linear-gradient(145deg, #d4af37, #c29a2b);
      color: #0b0a08;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      letter-spacing: 0.5px;
      transition: 0.3s;
      box-shadow: 0 6px 20px rgba(212, 175, 55, 0.25);
      border: 1px solid rgba(255, 215, 0, 0.15);
    }
    .btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 36px rgba(212, 175, 55, 0.5);
      background: #e6c45a;
    }
    .btn-outline {
      background: transparent;
      color: #d4af37;
      border: 2px solid #d4af37;
      box-shadow: none;
    }
    .btn-outline:hover {
      background: rgba(212, 175, 55, 0.08);
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(212, 175, 55, 0.15);
    }

    /* --- ICÔNES DE CONTACT (flottantes) --- */
    .contact-icons {
      position: fixed;
      bottom: 26px;
      display: flex;
      gap: 12px;
      z-index: 8;
      right: 20px;
      flex-direction: row-reverse;
    }
    .contact-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 24px;
      transition: 0.25s;
      box-shadow: 0 6px 24px rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .contact-icon:hover {
      transform: scale(1.12);
    }
    .icon-whatsapp { background: #25D366; color: white; }
    .icon-whatsapp:hover { box-shadow: 0 10px 36px #25D366; }
    .icon-phone { background: #1a73e8; color: white; }
    .icon-phone:hover { box-shadow: 0 10px 36px #1a73e8; }
    .icon-email { background: #ea4335; color: white; }
    .icon-email:hover { box-shadow: 0 10px 36px #ea4335; }
    .icon-map { background: #34a853; color: white; }
    .icon-map:hover { box-shadow: 0 10px 36px #34a853; }

    /* --- LIGHTBOX --- */
    #lightbox {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
      z-index: 1000;
      backdrop-filter: blur(6px);
    }
    #lightbox.show {
      opacity: 1;
      visibility: visible;
    }
    #lightbox img {
      max-width: 92%;
      max-height: 92%;
      border-radius: 20px;
      box-shadow: 0 0 60px rgba(212, 175, 55, 0.2);
      transition: 0.25s;
    }
    #lightbox .close {
      position: absolute;
      top: 28px;
      right: 40px;
      font-size: 44px;
      color: #fff;
      cursor: pointer;
      opacity: 0.7;
      transition: 0.2s;
    }
    #lightbox .close:hover { opacity: 1; transform: rotate(90deg); }

    /* --- PAGE TARIFS --- */
    #page-tarifs {
      display: none;
      padding: 40px 20px 60px;
    }
    #page-tarifs.active {
      display: block;
    }
    #page-tarifs .back-btn {
      display: inline-block;
      margin-bottom: 30px;
      padding: 10px 28px;
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid #d4af37;
      border-radius: 40px;
      color: #d4af37;
      text-decoration: none;
      transition: 0.3s;
    }
    #page-tarifs .back-btn:hover {
      background: rgba(212, 175, 55, 0.25);
    }
    .prices-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 20px;
    }
    .price-card {
      background: rgba(20, 18, 15, 0.7);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(212, 175, 55, 0.15);
      border-radius: 20px;
      padding: 24px 20px;
      transition: 0.3s;
      box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .price-card:hover {
      transform: translateY(-6px);
      border-color: #d4af37;
      box-shadow: 0 12px 40px rgba(212, 175, 55, 0.15);
    }
    .price-card h3 {
      color: #f5e3b3;
      font-size: 1.3rem;
      font-weight: 500;
      margin-bottom: 6px;
      letter-spacing: 0.3px;
    }
    .price-card .price {
      font-size: 2rem;
      font-weight: 700;
      color: #d4af37;
      margin: 10px 0 8px;
      letter-spacing: 1px;
    }
    .price-card .price small {
      font-size: 1rem;
      font-weight: 300;
      color: #b8a88a;
      margin-left: 4px;
    }
    .price-card .desc-price {
      color: #b8ab92;
      font-size: 0.95rem;
      line-height: 1.5;
      border-top: 1px solid rgba(212, 175, 55, 0.1);
      padding-top: 12px;
      margin-top: 8px;
    }
    .price-card .badge {
      display: inline-block;
      background: rgba(212, 175, 55, 0.15);
      color: #d4af37;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 2px 12px;
      border-radius: 30px;
      margin-top: 6px;
    }

    /* --- PAGE RÉSERVATION --- */
    #page-reservation {
      display: none;
      padding: 40px 20px 60px;
      max-width: 700px;
      margin: 0 auto;
    }
    #page-reservation.active {
      display: block;
    }
    #page-reservation .back-btn {
      display: inline-block;
      margin-bottom: 30px;
      padding: 10px 28px;
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid #d4af37;
      border-radius: 40px;
      color: #d4af37;
      text-decoration: none;
      transition: 0.3s;
    }
    #page-reservation .back-btn:hover {
      background: rgba(212, 175, 55, 0.25);
    }
    #page-reservation h2 {
      color: #d4af37;
      font-size: 32px;
      font-weight: 400;
      margin-bottom: 8px;
    }
    #page-reservation .sub {
      color: #b8ab92;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }
    .form-group {
      margin-bottom: 22px;
    }
    .form-group label {
      display: block;
      color: #e8d5a3;
      font-weight: 500;
      margin-bottom: 6px;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 14px 18px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(212, 175, 55, 0.2);
      border-radius: 14px;
      color: #f0ece4;
      font-size: 1rem;
      transition: 0.3s;
      outline: none;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: #d4af37;
      box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
      background: rgba(255,255,255,0.06);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: #6a655a;
    }
    .form-group select option {
      background: #1a1814;
      color: #f0ece4;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .submit-btn {
      width: 100%;
      padding: 16px;
      background: linear-gradient(145deg, #d4af37, #c29a2b);
      border: none;
      border-radius: 60px;
      color: #0b0a08;
      font-weight: 700;
      font-size: 1.15rem;
      cursor: pointer;
      transition: 0.3s;
      letter-spacing: 0.5px;
      margin-top: 8px;
    }
    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 36px rgba(212, 175, 55, 0.3);
    }
    .form-success {
      display: none;
      text-align: center;
      padding: 40px 20px;
      background: rgba(212, 175, 55, 0.05);
      border: 1px solid rgba(212, 175, 55, 0.2);
      border-radius: 20px;
      margin-top: 20px;
    }
    .form-success.show {
      display: block;
    }
    .form-success h3 {
      color: #d4af37;
      font-size: 28px;
      margin-bottom: 12px;
    }
    .form-success p {
      color: #b8ab92;
      font-size: 1.05rem;
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 640px) {
      h1 { font-size: 32px; }
      .gallery { grid-template-columns: 1fr 1fr; gap: 12px; }
      .gallery img { height: 150px; }
      .form-row { grid-template-columns: 1fr; }
      .contact-icons { right: 12px; gap: 8px; }
      .contact-icon { width: 44px; height: 44px; font-size: 18px; }
    }
    @media (max-width: 430px) {
      .gallery { grid-template-columns: 1fr; }
      .btn { padding: 14px 28px; }
    }
  </style>
</head>
<body>

  <!-- LOADER -->
  <div id="loader"><div class="loader-ring"></div></div>

  <!-- BACKGROUND -->
  <div class="bg-image"></div>
  <div class="overlay-gradient"></div>
  <div class="lens-flare" id="lensFlare"></div>
  <canvas id="particles"></canvas>

  <!-- PAGE ACCUEIL -->
  <div id="page-accueil">
    <header>
      <img src="assets/mlogo.png" class="logo" alt="GS 4C" onerror="this.style.display='none'">
      <h1>GS 4C</h1>
      <div class="subhead">Carrosserie · Peinture · Lustrage</div>
      <div class="slogan-main">Qualité professionnelle — Finition premium — Satisfaction garantie</div>
    </header>

    <!-- GALERIE 1 : Peinture Étrier & Jantes -->
    <section class="container gallery-group">
      <h2>Peinture Étrier &amp; Jantes</h2>
      <p class="desc">Une touche sportive et élégante. Nos peintures haute température résistent à la chaleur et aux agressions.</p>
      <div class="gallery" id="gallery1">
        <img src="https://images.unsplash.com/photo-1601462272429-9c3b8f6e937d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="jante 1" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1616422285623-bf2c0fe1c718?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="jante 2" onclick="openLightbox(this.src)">
        <!-- 5 photos extra pour Peinture Étrier & Jantes -->
        <img src="https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="jante sport" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1606016159991-dfe4f2746ad5?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="étrier rouge" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1583121274602-3e2820c69888?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="jante noir" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="étrier jaune" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1590362891991-f776e747a588?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="jante luxe" class="extra" onclick="openLightbox(this.src)">
      </div>
      <button class="show-more" onclick="toggleExtra(this)">+ Voir plus (5 photos)</button>
    </section>

    <!-- GALERIE 2 : Lustrage & Polissage -->
    <section class="container gallery-group">
      <h2>Lustrage &amp; Polissage</h2>
      <p class="desc">Élimination des micro‑rayures et oxydation. Une profondeur de miroir qui redonne vie à votre peinture.</p>
      <div class="gallery" id="gallery2">
        <img src="https://images.unsplash.com/photo-1567905522131-e2b26dc1c86d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="lustrage 1" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=2064&auto=format&fit=crop&ixlib=rb-4.0.3" alt="lustrage 2" onclick="openLightbox(this.src)">
        <!-- 5 photos extra pour Lustrage & Polissage -->
        <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="voiture brillante" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="polissage main" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1494976388531-d1058494cdd8?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="carrosserie miroir" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1583121274602-3e2820c69888?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="lustrage capot" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1553440569-bcc63803a83d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="finition parfaite" class="extra" onclick="openLightbox(this.src)">
      </div>
      <button class="show-more" onclick="toggleExtra(this)">+ Voir plus (5 photos)</button>
    </section>

    <!-- GALERIE 3 : Detailing Intérieur -->
    <section class="container gallery-group">
      <h2>Detailing Intérieur</h2>
      <p class="desc">Nettoyage en profondeur, soin des matériaux, cuir, tissu et plastiques. Un habitacle comme neuf.</p>
      <div class="gallery" id="gallery3">
        <img src="https://images.unsplash.com/photo-1607863680198-23d4b2565df5?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3" alt="intérieur 1" onclick="openLightbox(this.src)">
        <!-- 5 photos extra pour Detailing Intérieur -->
        <img src="https://images.unsplash.com/photo-1583121274602-3e2820c69888?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="sièges propres" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=2064&auto=format&fit=crop&ixlib=rb-4.0.3" alt="tableau de bord" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="intérieur cuir" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1494976388531-d1058494cdd8?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="volant propre" class="extra" onclick="openLightbox(this.src)">
        <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3" alt="habitacle net" class="extra" onclick="openLightbox(this.src)">
      </div>
      <button class="show-more" onclick="toggleExtra(this)">+ Voir plus (5 photos)</button>
    </section>

    <!-- BOUTONS -->
    <div class="buttons">
      <a href="#" class="btn" onclick="showPage('reservation')">📅 Réserver</a>
      <a href="#" class="btn btn-outline" onclick="showPage('tarifs')">💰 Voir les tarifs</a>
    </div>
  </div>

  <!-- PAGE TARIFS -->
  <div id="page-tarifs">
