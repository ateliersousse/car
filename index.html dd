  <!-- ICÔNES DE CONTACT (flottantes) -->
  <div class="contact-icons">
    <a href="https://wa.me/21692078100" class="contact-icon icon-whatsapp" target="_blank" aria-label="WhatsApp">💬</a>
    <a href="tel:+21692078100" class="contact-icon icon-phone" aria-label="Téléphone">📞</a>
    <a href="mailto:abaklouti09@gmail.com" class="contact-icon icon-email" aria-label="Email">✉</a>
    <a href="https://www.google.com/maps?q=35.825441,10.569808" target="_blank" class="contact-icon icon-map" aria-label="Localisation">📍</a>
  </div>

  <!-- LIGHTBOX -->
  <div id="lightbox">
    <span class="close" onclick="closeLightbox()">&times;</span>
    <img id="lightbox-img" src="" alt="agrandissement">
  </div>

  <script>
    // --- LOADER ---
    window.addEventListener('load', () => {
      const loader = document.getElementById('loader');
      loader.classList.add('hidden');
      setTimeout(() => { loader.style.display = 'none'; }, 700);
    });

    // --- NAVIGATION PAGES ---
    function showPage(page) {
      document.getElementById('page-accueil').style.display = page === 'accueil' ? 'block' : 'none';
      document.getElementById('page-tarifs').classList.toggle('active', page === 'tarifs');
      document.getElementById('page-reservation').classList.toggle('active', page === 'reservation');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // --- LIGHTBOX ---
    function openLightbox(src) {
      const lb = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      img.style.opacity = '0';
      img.src = src;
      lb.classList.add('show');
      setTimeout(() => img.style.opacity = '1', 50);
    }
    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('show');
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // --- TOGGLE EXTRA (afficher/masquer 5 photos) ---
    function toggleExtra(button) {
      const gallery = button.previousElementSibling;
      const extras = gallery.querySelectorAll('.extra');
      const anyVisible = Array.from(extras).some(img => img.style.display === 'block');

      extras.forEach((img, i) => {
        if (anyVisible) {
          img.style.display = 'none';
          img.classList.remove('show');
        } else {
          img.style.display = 'block';
          setTimeout(() => img.classList.add('show'), i * 120);
        }
      });
      button.textContent = anyVisible ? '+ Voir plus (5 photos)' : '− Voir moins';
    }

    // --- FORMULAIRE → WHATSAPP ---
    function sendWhatsApp(event) {
      event.preventDefault();

      const nom = document.getElementById('nom').value.trim();
      const telephone = document.getElementById('telephone').value.trim();
      const email = document.getElementById('email').value.trim();
      const service = document.getElementById('service').value;
      const date = document.getElementById('date').value;
      const details = document.getElementById('details').value.trim();

      if (!nom || !telephone || !service || !date) {
        alert('Veuillez remplir tous les champs obligatoires (*)');
        return;
      }

      let message = `📋 *NOUVELLE DEMANDE DE RÉSERVATION*%0A%0A`;
      message += `👤 *Nom :* ${nom}%0A`;
      message += `📱 *Téléphone :* ${telephone}%0A`;
      if (email) message += `✉️ *Email :* ${email}%0A`;
      message += `🔧 *Service :* ${service}%0A`;
      message += `📅 *Date souhaitée :* ${date}%0A`;
      if (details) message += `📝 *Détails :* ${details}%0A`;
      message += `%0A📲 *Demande envoyée depuis le site GS 4C*`;

      const url = `https://wa.me/21692078100?text=${message}`;
      window.open(url, '_blank');

      document.getElementById('reservationForm').style.display = 'none';
      document.getElementById('formSuccess').classList.add('show');
    }

    // --- PARTICULES ---
    const canvas = document.getElementById('particles');
    const ctx = canvas.getContext('2d');
    let w = window.innerWidth;
    let h = window.innerHeight;
    canvas.width = w; canvas.height = h;

    const particles = [];
    for (let i = 0; i < 140; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 2.2 + 1.2,
        speed: Math.random() * 0.9 + 0.3
      });
    }

    function drawParticles() {
      ctx.clearRect(0, 0, w, h);
      particles.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(212, 175, 55, 0.45)';
        ctx.fill();
        p.y -= p.speed;
        if (p.y < -10) { p.y = h + 10; p.x = Math.random() * w; }
      });
      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    window.addEventListener('resize', () => {
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = w; canvas.height = h;
    });

    // --- SCROLL REVEAL ---
    const images = document.querySelectorAll('.gallery img');
    const textEls = document.querySelectorAll('#page-accueil h2, #page-accueil .desc, .slogan-main, .subhead');

    function revealOnScroll() {
      const winH = window.innerHeight;
      images.forEach(img => {
        const rect = img.getBoundingClientRect();
        if (rect.top < winH - 80) img.classList.add('show');
      });
      textEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < winH - 60) {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }
      });
    }

    textEls.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(18px)';
      el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
    });
    images.forEach(img => img.style.transition = 'opacity 0.6s ease, transform 0.4s ease, box-shadow 0.3s');

    window.addEventListener('scroll', revealOnScroll);
    window.addEventListener('load', () => {
      setTimeout(revealOnScroll, 400);
    });

    // --- LENS FLARE ---
    const flare = document.getElementById('lensFlare');
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      flare.style.transform = `translate(${y * 0.015}px, ${y * 0.01}px)`;
    });

    // --- GESTION IMAGES ---
    document.querySelectorAll('.gallery img').forEach(img => {
      img.onerror = function() {
        this.style.display = 'none';
      };
    });

    // --- DATE MIN ---
    document.addEventListener('DOMContentLoaded', () => {
      const dateInput = document.getElementById('date');
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.setAttribute('min', today);
      }
    });
  </script>

</body>
