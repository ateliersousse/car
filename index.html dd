  <!-- PAGE RÉSERVATION -->
  <div id="page-reservation">
    <a href="#" class="back-btn" onclick="showPage('accueil')">← Retour</a>
    <h2>Réserver une prestation</h2>
    <p class="sub">Remplissez ce formulaire et nous vous confirmerons votre rendez-vous.</p>

    <form id="reservationForm" onsubmit="sendWhatsApp(event)">
      <div class="form-row">
        <div class="form-group">
          <label for="nom">Nom complet *</label>
          <input type="text" id="nom" placeholder="Votre nom et prénom" required>
        </div>
        <div class="form-group">
          <label for="telephone">Téléphone *</label>
          <input type="tel" id="telephone" placeholder="+216 00 000 000" required>
        </div>
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" placeholder="votre@email.com">
      </div>
      <div class="form-group">
        <label for="service">Service souhaité *</label>
        <select id="service" required>
          <option value="">-- Sélectionnez --</option>
          <option value="Peinture Étriers">Peinture Étriers (120 DT)</option>
          <option value="Peinture Jantes">Peinture Jantes (280 DT)</option>
          <option value="Lustrage & Polissage">Lustrage & Polissage (250 DT)</option>
          <option value="Detailing Intérieur">Detailing Intérieur (180 DT)</option>
          <option value="Peinture Carrosserie">Peinture Carrosserie (sur devis)</option>
